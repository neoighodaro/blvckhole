FROM docker/sandbox-templates:claude-code-minimal

USER root

RUN apt-get update \
 && apt-get install -y --no-install-recommends zsh zsh-autosuggestions zsh-syntax-highlighting{{ if .Packages }} {{ join .Packages " " }}{{ end }} \
 && rm -rf /var/lib/apt/lists/* \
 && sed -i '/^agent:/ s|:[^:]*$|:/usr/bin/zsh|' /etc/passwd
{{- range .RootBlocks }}

{{ . }}
{{- end }}

USER agent
{{- range .AgentBlocks }}

{{ . }}
{{- end }}
{{- range .EnvBlocks }}

{{ . }}
{{- end }}
{{- if .Plugins.Marketplaces }}
{{ range .Plugins.Marketplaces }}
RUN claude plugin marketplace add {{ . }}
{{- end }}
{{- end }}
{{- if .Plugins.Install }}
{{ range .Plugins.Install }}
RUN claude plugin install {{ . }}
{{- end }}
{{- end }}
